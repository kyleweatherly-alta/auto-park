{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-park",
  // Kyle's personal Cloudflare account (kyle.weatherly@gmail.com), which holds kyleweatherly.com.
  // Deploy with XDG_CONFIG_HOME=~/.config/kyle-personal so Alta's wrangler sign-in isn't used.
  "account_id": "b79e4796d5980902455aa2a35993b36b",
  "main": "worker/index.ts",
  "routes": [{ "pattern": "park.kyleweatherly.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTOPARK", "class_name": "AutoParkDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AutoParkDO"] }],
  "vars": {
    "LOT_CODE": "Q60x6xih",
    "LOT_NAME": "MAC Member Parking",
    "PARK_ENGINE": "api",
    "RUNS_PER_HOUR": "30"
  },
  "observability": { "enabled": true }
}
