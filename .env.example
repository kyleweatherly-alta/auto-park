# Copy to .env for local runs. The public Cloudflare site takes these from wrangler.jsonc "vars".
# Nothing personal goes here: plate, phone and promo code are entered in the app and stay in each browser.

# How purchases are made when a device hasn't chosen: auto (fast API, falls back to the
# browser on this Mac), api, browser, or fake (simulated, nothing is bought)
PARK_ENGINE=auto
# TapNPark lot (the code in the lot's QR link) and its display name
LOT_CODE=Q60x6xih
LOT_NAME=MAC Member Parking
# Purchases each visitor (IP address) may start per hour
RUNS_PER_HOUR=30
# Where browser-engine screenshots are kept (local runs only)
DATA_DIR=./data
PORT=8787
# Path to a system Chrome/Chromium for the browser engine (leave empty to use Playwright's own)
BROWSER_EXECUTABLE_PATH=
