# --- Required -------------------------------------------------------------
# Passcode you type once on each device to unlock the app.
APP_PASSCODE=change-me
# Long random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Your details (used to seed the profile on first run; editable in the app)
DEFAULT_PLATE=
DEFAULT_PHONE=
DEFAULT_PROMO=
# Rate name exactly as TapNPark shows it, e.g. "MAC Member - 3 Hours"
DEFAULT_RATE=

# --- Optional -------------------------------------------------------------
# TapNPark lot (the code in the lot's QR link) and its display name
LOT_CODE=Q60x6xih
LOT_NAME=MAC Member Parking
# How purchases are made: auto (fast API, falls back to browser), api, browser, fake (no real purchases)
PARK_ENGINE=auto
# Where the profile, history and screenshots are kept
DATA_DIR=./data
PORT=8787
# Path to a system Chromium for the browser engine (leave empty to use Playwright's own)
BROWSER_EXECUTABLE_PATH=
